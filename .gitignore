# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Local scratch at the repo root (meet inputs such as heat lists) stays local
/tmp/

# Your own things: report configs, rosters, collected data, report output, Recordings of
# Athletic.net responses and handoff notes. Optionally its own private git repo (see the README).
/local/

# The older places for those, from before local/. local/ is their home now; these stay ignored
# so a checkout that still has them never commits them. tests/local.rs fails when git tracks
# anything this file ignores.
/tools/*/*.config.json
/tools/*/data/
/tools/*/out/
/tools/seedsheet/*.csv
/tools/arearank/
/.claude/handoffs/

# Python bytecode from the reports under tools/
__pycache__/

# The published examples' site, built by examples/build_site.py (and its tests) from examples/
/examples/site/

# Claude Code: per-ticket feature worktrees and machine-local settings
.claude/worktrees/
.claude/settings.local.json

# Matt Pocock's agent skills, installed by whoever wants them (see docs/agents/skills.md), not
# vendored: the installed files, the CLI's lock file, and each skill's link in .claude/skills/,
# by name, so a skill of the repo's own there is tracked. tests/local.rs lists the same names.
/.agents/
/skills-lock.json
/.claude/skills/domain-modeling
/.claude/skills/grill-with-docs
/.claude/skills/grilling
/.claude/skills/implement
/.claude/skills/setup-matt-pocock-skills
/.claude/skills/to-spec
/.claude/skills/to-tickets
